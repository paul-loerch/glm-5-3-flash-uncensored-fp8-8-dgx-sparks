# config/recipe.env -- WHAT is served. launch/up.sh reads it together with cluster.env (WHERE it runs).
#
# The @...@ placeholders are filled from cluster.env before this file is read. Whatever is written here, the launcher
# forces the model path, --port, --master-addr, --master-port, --nnodes, --tensor-parallel-size and
# --gpu-memory-utilization to the cluster.env values, and adds --node-rank / --headless per rank.
# The comments below explain every flag and variable; PATCHES.md explains the patch switches. The published numbers
# (README, "Results at a glance") were measured with exactly this file.

# The image built by image/build.sh (official vLLM v0.32.0 + the GB10 build-time edits).
M_IMAGE=glm53-flash-sm121:v032-1

# Run patches/entrypoint.sh at container start: it applies patches/NNN-*.sh in order (each one checks the sha256 of
# every file it touches and refuses on any difference), then starts vLLM. The directory must be identical on every node.
M_BOOT_ENTRYPOINT=recipe
M_PATCH_DIR=patches

# vLLM arguments. Container paths under /opt/recipe-patches are the patch directory mounted read-only.
M_VLLM_ARGS='@MODEL_DIR@ --served-model-name glm53-uncen-fp8-tp8 --host 0.0.0.0 --port @API_PORT@ --trust-remote-code --max-model-len 1048576 --gpu-memory-utilization @GPU_MEMORY_UTILIZATION@ --max-num-seqs 8 --max-num-batched-tokens 8192 --long-prefill-token-threshold 3840 --kv-cache-dtype fp8_e4m3 --kv-cache-memory-bytes 17179869184 --moe-backend triton --block-size 256 --enable-prefix-caching --prefix-match-unit 8 --enable-prompt-tokens-details --enable-auto-tool-choice --tool-parser-plugin /opt/recipe-patches/plugins/glm45_auto_tool_parser.py --tool-call-parser glm45_auto --reasoning-parser glm45 --chat-template /opt/recipe-patches/files/p024_glm53_chat_template.jinja --tensor-parallel-size 8 --pipeline-parallel-size 1 --nnodes 8 --master-addr @MASTER_ADDR@ --master-port @MASTER_PORT@ --distributed-executor-backend mp --language-model-only --load-format safetensors --no-enable-flashinfer-autotune --disable-custom-all-reduce --cudagraph-capture-sizes 1 2 4 6 8 16 24 32 40 48 --speculative-config '"'"'{"method":"mtp","num_speculative_tokens":2,"num_speculative_tokens_per_batch_size":[[1,1,2],[2,8,1]],"draft_sample_method":"probabilistic"}'"'"' --limit-mm-per-prompt '"'"'{"image":0,"video":0}'"'"' --generation-config /opt/recipe-patches/files/gencfg'

# Container environment: the runtime patches' switches (VLLM_GB10_*), plus engine and NCCL settings for eight GB10
# nodes over RoCE. Removing a VLLM_GB10_* switch turns that patch off (it then logs "[state] patch NNN inert"); for 035
# also delete its "require" rule in launch/readiness.txt. Patch 001 has no switch.
M_DOCKER_EXTRA='-e VLLM_GB10_IDX_COMPACT_XCHG=1 -e VLLM_USE_DEEP_GEMM=0 -e VLLM_MOE_USE_DEEP_GEMM=0 -e CUTE_DSL_ARCH=sm_121a -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=600 -e VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=64 -e TILELANG_CACHE_DIR=/cache/huggingface/tilelang-cache -e VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0 -e VLLM_GB10_BLOCKING_SYNC=1 -e NCCL_MAX_NCHANNELS=4 -e VLLM_GB10_ONESHOT_AR=1 -e VLLM_GB10_SKINNY_IDX=1 -e VLLM_GB10_MHC_BM2_MIN_T=128 -e VLLM_GB10_MHC_FN_BF16=1 -e VLLM_GB10_SPARSE_MLA_TRITON_PREFILL=1 -e VLLM_GB10_MHC_PRS=1 -e NCCL_DEBUG_FILE=/dev/stderr -e VLLM_GB10_IDX_SHARD=1 -e VLLM_GB10_REPL_EMBED=1 -e VLLM_GB10_DRAFT_COMPRESS=1 -e VLLM_GB10_DRAFT_COMPRESS_PARTS=head -e VLLM_GB10_MHC_SP=1 -e VLLM_GB10_MLA_W8A16=1 -e VLLM_ALLREDUCE_USE_FLASHINFER=0'
